# ============================================================
# PORTFOLIO APP — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in real values
# ============================================================

# ------------------------------------------------------------
# APP — General
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Portfolio Studio"
NEXT_PUBLIC_LOCALE_DEFAULT=vi

# ------------------------------------------------------------
# AUTH — NextAuth.js
# ------------------------------------------------------------
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Magic Link (Nodemailer SMTP)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@portfolio.studio

# Admin whitelist (comma-separated)
ADMIN_EMAILS=admin@portfolio.studio

# ------------------------------------------------------------
# DATABASE — Prisma ORM
# ------------------------------------------------------------
# PostgreSQL (Neon / Supabase / Vercel Postgres)
DATABASE_URL=postgresql://user:password@host:5432/portfolio?sslmode=require

# ------------------------------------------------------------
# STORAGE — Cloudinary (image uploads)
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ------------------------------------------------------------
# GOOGLE MAPS — On-Site Placement
# ------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id-for-vector-tiles

# G5 CORS Proxy Fallback (default: false)
ALLOW_PROXY_FALLBACK=false

# ------------------------------------------------------------
# ANALYTICS — Plausible
# ------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=portfolio.studio
NEXT_PUBLIC_PLAUSIBLE_URL=https://plausible.io

# ------------------------------------------------------------
# OG IMAGE — Satori / @vercel/og
# ------------------------------------------------------------
OG_FONT_PATH=/fonts/PlayfairDisplay-Bold.ttf
OG_IMAGE_WIDTH=1200
OG_IMAGE_HEIGHT=630

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------
RATE_LIMIT_RPM=60

# ------------------------------------------------------------
# DEV ONLY
# ------------------------------------------------------------
# PRISMA_LOG_LEVEL=query,info,warn,error
# EMAIL_DEV_MODE=true
# SEED_DATABASE=true
